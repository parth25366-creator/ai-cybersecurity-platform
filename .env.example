# Required
OPENAI_API_KEY=your-api-key      # OpenAI key, or a Gemini key when LLM_BASE_URL is set
JWT_SECRET=change-me-min-16-chars   # generate: openssl rand -hex 32

# Optional: use an OpenAI-compatible provider (example: Google Gemini free tier)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-3-flash-preview
# EMBED_MODEL=gemini-embedding-001

# Optional hardening
# OPEN_REGISTRATION=false   # close self-signup once your accounts exist
# MAX_UPLOAD_MB=5
